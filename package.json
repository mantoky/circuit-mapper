{
  "name": "circuit-mapper",
  "version": "1.0.0",
  "private": true,
  "description": "Mapeamento e Cadastro de Circuitos Eletricos - laudo tecnico NBR 5410",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node tests/build-and-test.js",
    "build:web": "node tools/bundleWeb.js",
    "deploy:vps": "powershell -ExecutionPolicy Bypass -File tools/deployVps.ps1",
    "samples": "node tests/generateSamples.js",
    "build:apk": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile preview",
    "prebuild": "expo prebuild"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-status-bar": "~1.12.1",
    "expo-blur": "~13.0.2",
    "expo-print": "~13.0.1",
    "expo-sharing": "~12.0.1",
    "expo-file-system": "~17.0.1",
    "expo-image-picker": "~15.0.7",
    "expo-document-picker": "~12.0.2",
    "expo-media-library": "~16.0.4",
    "expo-font": "~12.0.9",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "react-native-view-shot": "3.8.0",
    "react-native-svg": "15.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "jsdom": "^24.1.0"
  }
}
